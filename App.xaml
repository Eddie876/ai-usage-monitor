<Application x:Class="AiUsageWidget.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml" ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#0F1115" />
    <SolidColorBrush x:Key="CardBrush" Color="#181B21" />
    <SolidColorBrush x:Key="BorderBrush" Color="#262A33" />
    <SolidColorBrush x:Key="TextBrush" Color="#E6E8EB" />
    <SolidColorBrush x:Key="MutedBrush" Color="#9AA3AD" />
    <SolidColorBrush x:Key="TrackBrush" Color="#2A2F39" />
    <SolidColorBrush x:Key="AccentBrush" Color="#7AA2F7" />
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="FontFamily" Value="Segoe UI, Microsoft JhengHei UI"/><Setter Property="FontSize" Value="14"/></Style>
    <Style x:Key="IconButton" TargetType="Button"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Background" Value="{StaticResource CardBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource TrackBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </Application.Resources>
</Application>
